# parser features: definitions, multiline definitions, sequences, conditionals, BFD, track_file
$IFACE=fz0
$VIPS= \
  192.168.10.1/24 \
  192.168.10.2/24
@main $PRIO=150
@^main $PRIO=50
global_defs {
  router_id main
  dynamic_interfaces
  vrrp_garp_master_delay 3
  enable_script_security
}
vrrp_track_file TF1 {
  file track.state
  weight -10
}
bfd_instance BFD1 {
  neighbor_ip 10.0.0.2
  source_ip 10.0.0.1
  min_rx 100
  min_tx 100
  multiplier 3
}
~SEQ(ID, 1, 3) vrrp_instance VI_${ID} { state BACKUP; interface $IFACE; virtual_router_id ${ID}; priority $PRIO; virtual_ipaddress { 10.9.${ID}.1 } }
vrrp_instance VI_X {
  state BACKUP
  interface $IFACE
  virtual_router_id 77
  priority $PRIO
  version 3
  track_file { TF1 weight 5 }
  track_bfd { BFD1 }
  virtual_ipaddress {
    $VIPS
  }
  virtual_routes {
    10.66.0.0/16 via 192.168.10.254 dev $IFACE
  }
}
